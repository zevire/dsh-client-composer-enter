{
  "name": "dsh-client-composer-enter",
  "version": "0.4.1",
  "private": true,
  "type": "module",
  "description": "dsh Web client plugin: Enter inserts a line break, Shift/Alt+Enter sends. No dsh source changes.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "dsh-client-plugin"
  ],
  "license": "MIT",
  "author": "zevire",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zevire/dsh-client-composer-enter.git"
  },
  "homepage": "https://github.com/zevire/dsh-client-composer-enter#readme",
  "bugs": {
    "url": "https://github.com/zevire/dsh-client-composer-enter/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "icon": "./icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*": "./locale/*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "src",
    "cordis.patch.yml",
    "locale",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node scripts/test.mjs"
  }
}
